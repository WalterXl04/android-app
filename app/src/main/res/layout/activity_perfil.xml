<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meu Perfil"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#B71C1C"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E-mail (Não editável)"
        android:textColor="#757575"/>

    <EditText
        android:id="@+id/edit_perfil_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#E0E0E0"
        android:enabled="false"
        android:padding="12dp"
        android:textColor="#9E9E9E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome Completo"
        android:textColor="#B71C1C"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/edit_perfil_nome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/white"
        android:padding="12dp"
        android:hint="Digite seu nome"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telefone (WhatsApp)"
        android:textColor="#B71C1C"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/edit_perfil_telefone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/white"
        android:padding="12dp"
        android:inputType="phone"
        android:hint="(00) 00000-0000"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_salvar_perfil"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ATUALIZAR DADOS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#FFB300"
        android:textColor="#FFFFFF"/>

</LinearLayout>